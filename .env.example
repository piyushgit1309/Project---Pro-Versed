# PRO-VERSED Environment Configuration Template
# Copy this file to .env and configure your environment variables.
# NEVER commit real production credentials to source control.

# Canonical Database Configuration (PostgreSQL in production)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/proversed_db

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
